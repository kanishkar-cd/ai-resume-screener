# Backend application configuration
APP_NAME=AI Resume Screener API
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/resume_screener_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=resume_screener_db

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Groq AI Enhancement Layer Credentials
ENABLE_AI_INSIGHTS=false
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=5.0
GROQ_MAX_RETRIES=1

# OCR Fallback Configuration
ENABLE_OCR_FALLBACK=true
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
OCR_DPI=200
